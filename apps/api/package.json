{
  "name": "@fides/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/run-seed.ts"
  },
  "dependencies": {
    "@fides/contracts": "workspace:*",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fides/test-fixtures": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
